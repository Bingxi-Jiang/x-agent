# Official X API read access. Set X_USE_FIXTURES=true for local UI calibration without live X access.
X_BEARER_TOKEN=
X_USE_FIXTURES=false

# Only enabled providers require credentials. Model names can be changed independently.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional. Defaults to data/x-agent.db.
DATABASE_PATH=
