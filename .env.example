# Set true only for local UI calibration without a captured X For You feed.
X_USE_FIXTURES=false

# Optional locally; recommended for a forwarded/public URL. Enter the same value in extension options.
X_AGENT_IMPORT_TOKEN=

# Only enabled providers require credentials. Model names can be changed independently.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional. Defaults to data/x-agent.db.
DATABASE_PATH=
