# Set true only for local UI calibration without a captured X For You feed.
X_USE_FIXTURES=false

# Optional on localhost; required when exposing the app beyond your machine.
# Generate a unique value locally and never commit it.
X_AGENT_IMPORT_TOKEN=

# Only enabled providers require credentials. Never commit real keys.
# Model names can be changed independently.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional. Defaults to data/x-agent.db.
DATABASE_PATH=
